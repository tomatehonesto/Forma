{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "forma-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "forma-expo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 8081
    },
    {
      "name": "forma-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--no-dev",
        "--port",
        "8082"
      ],
      "port": 8082
    }
  ]
}
