{
  "expo": {
    "name": "Morphi",
    "slug": "morphi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "morphi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.morphihealth.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.morphihealth.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ]
    },
    "locales": {
      "pt": "./permissoes/pt.json",
      "en": "./permissoes/en.json",
      "es": "./permissoes/es.json",
      "fr": "./permissoes/fr.json",
      "it": "./permissoes/it.json",
      "de": "./permissoes/de.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmera quando você fotografa o seu prato, para estimar a proteína da refeição, ou um laudo de exame, para ler os resultados.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Abrimos as suas fotos para você escolher a imagem de uma refeição, de um laudo de exame ou a sua foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos a sua localização para mostrar a distância até os consultórios da rede. Ela fica no aparelho e não é enviada a ninguém.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Não usamos os sensores de movimento do aparelho."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#065CF5",
          "defaultChannel": "lembretes"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Lemos as suas pesagens do Apple Saúde para completar a sua curva de evolução sem você digitar. Elas entram no seu diário como as que você registra — guardamos na sua conta e, se você se conectar a uma clínica, a equipe dela também as vê.",
          "NSHealthUpdateUsageDescription": "Não escrevemos nada no Apple Saúde — só lemos as suas pesagens.",
          "background": false
        }
      ],
      "./plugins/politica-no-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Original",
            "ios": "./assets/icones/original.png",
            "android": {
              "foregroundImage": "./assets/icones/original-frente.png",
              "backgroundColor": "#065CF5"
            }
          },
          {
            "name": "Amora",
            "ios": "./assets/icones/amora.png",
            "android": {
              "foregroundImage": "./assets/icones/amora-frente.png",
              "backgroundColor": "#6B3BF5"
            }
          },
          {
            "name": "Vinho",
            "ios": "./assets/icones/vinho.png",
            "android": {
              "foregroundImage": "./assets/icones/vinho-frente.png",
              "backgroundColor": "#830F3E"
            }
          },
          {
            "name": "Telha",
            "ios": "./assets/icones/telha.png",
            "android": {
              "foregroundImage": "./assets/icones/telha-frente.png",
              "backgroundColor": "#852102"
            }
          },
          {
            "name": "Oliva",
            "ios": "./assets/icones/oliva.png",
            "android": {
              "foregroundImage": "./assets/icones/oliva-frente.png",
              "backgroundColor": "#555D1C"
            }
          },
          {
            "name": "Floresta",
            "ios": "./assets/icones/floresta.png",
            "android": {
              "foregroundImage": "./assets/icones/floresta-frente.png",
              "backgroundColor": "#15803D"
            }
          },
          {
            "name": "Oceano",
            "ios": "./assets/icones/oceano.png",
            "android": {
              "foregroundImage": "./assets/icones/oceano-frente.png",
              "backgroundColor": "#017482"
            }
          },
          {
            "name": "Marinho",
            "ios": "./assets/icones/marinho.png",
            "android": {
              "foregroundImage": "./assets/icones/marinho-frente.png",
              "backgroundColor": "#033B7A"
            }
          },
          {
            "name": "Camurca",
            "ios": "./assets/icones/camurca.png",
            "android": {
              "foregroundImage": "./assets/icones/camurca-frente.png",
              "backgroundColor": "#655046"
            }
          },
          {
            "name": "Grafite",
            "ios": "./assets/icones/grafite.png",
            "android": {
              "foregroundImage": "./assets/icones/grafite-frente.png",
              "backgroundColor": "#2E3440"
            }
          }
        ]
      ],
      "./plugins/porta-padrao-do-icone",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Usamos o microfone quando você toca para ditar uma pergunta em vez de digitar.",
          "speechRecognitionPermission": "Transformamos a sua fala em texto no campo de pergunta. Você lê o que saiu antes de enviar."
        }
      ],
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.796644798626-iruf2biomgi2n7qo5jg4q23fsv0to6g3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/gs-packs/forma"
    },
    "extra": {
      "eas": {
        "projectId": "6e8df074-03cc-4e12-88f9-e23b4c83d223"
      }
    },
    "owner": "delusional-company",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e8df074-03cc-4e12-88f9-e23b4c83d223"
    }
  }
}
