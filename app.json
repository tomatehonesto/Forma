{
  "expo": {
    "name": "Morphi",
    "slug": "morphi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "morphi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmera para ler o seu prato e estimar a proteína da refeição.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Abrimos as suas fotos para você escolher a imagem de uma refeição ou a sua foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#065CF5",
          "defaultChannel": "lembretes"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Lemos as suas pesagens do Apple Saúde para a sua curva de evolução ficar completa sem você digitar."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "original",
            "ios": "./assets/icones/original.png",
            "android": {
              "foregroundImage": "./assets/icones/original-frente.png",
              "backgroundColor": "#065CF5"
            }
          },
          {
            "name": "amora",
            "ios": "./assets/icones/amora.png",
            "android": {
              "foregroundImage": "./assets/icones/amora-frente.png",
              "backgroundColor": "#6B3BF5"
            }
          },
          {
            "name": "framboesa",
            "ios": "./assets/icones/framboesa.png",
            "android": {
              "foregroundImage": "./assets/icones/framboesa-frente.png",
              "backgroundColor": "#C4187F"
            }
          },
          {
            "name": "brasa",
            "ios": "./assets/icones/brasa.png",
            "android": {
              "foregroundImage": "./assets/icones/brasa-frente.png",
              "backgroundColor": "#C2410C"
            }
          },
          {
            "name": "oceano",
            "ios": "./assets/icones/oceano.png",
            "android": {
              "foregroundImage": "./assets/icones/oceano-frente.png",
              "backgroundColor": "#0E7490"
            }
          },
          {
            "name": "floresta",
            "ios": "./assets/icones/floresta.png",
            "android": {
              "foregroundImage": "./assets/icones/floresta-frente.png",
              "backgroundColor": "#15803D"
            }
          },
          {
            "name": "indigo",
            "ios": "./assets/icones/indigo.png",
            "android": {
              "foregroundImage": "./assets/icones/indigo-frente.png",
              "backgroundColor": "#3730A3"
            }
          },
          {
            "name": "vinho",
            "ios": "./assets/icones/vinho.png",
            "android": {
              "foregroundImage": "./assets/icones/vinho-frente.png",
              "backgroundColor": "#9F1239"
            }
          },
          {
            "name": "menta",
            "ios": "./assets/icones/menta.png",
            "android": {
              "foregroundImage": "./assets/icones/menta-frente.png",
              "backgroundColor": "#0D9488"
            }
          },
          {
            "name": "grafite",
            "ios": "./assets/icones/grafite.png",
            "android": {
              "foregroundImage": "./assets/icones/grafite-frente.png",
              "backgroundColor": "#2E3440"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/gs-packs/forma"
    }
  }
}
